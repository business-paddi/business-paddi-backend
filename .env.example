DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
NODE_ENV="development"
PORT="5000"
FRONTEND_URL="http://localhost:3000"
COOKIE_SECURE="false"
# Set to the exact trusted proxy topology in production, e.g. a hop count or CIDR list.
TRUST_PROXY=""
GOOGLE_CLIENT_ID="your-google-web-client-id"
GOOGLE_CLIENT_SECRET="your-google-web-client-secret"
GOOGLE_REDIRECT_URL="http://localhost:3001/api/auth/google/callback"
REDIS_URL="redis://localhost:6379"
# Worker and durable outbox relay run with the API. Disable only on replicas that should not process mail.
INVITE_EMAIL_ENABLED="true"
# Frontend invitation dashboard route. Email links include only inviteId.
INVITE_FRONTEND_PATH="/dashboard/invites"
VERIFICATION_CODE_PEPPER="generate-a-random-32-byte-secret"
AUDIT_LOG_PEPPER="generate-an-independent-random-32-byte-secret"
RATE_LIMIT_PEPPER="generate-an-independent-random-32-byte-secret"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="900"
LOGIN_RATE_LIMIT_IP_MAX="30"
LOGIN_RATE_LIMIT_ACCOUNT_MAX="8"
RESEND_KEY="re_your_api_key"
RESEND_FROM_EMAIL="businesspaddi <onboarding@your-verified-domain.com>"
JWT_ACCESS_SECRET="generate-a-random-secret"
JWT_REFRESH_SECRET="generate-a-different-random-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="1d"
JWT_ISSUER="businesspaddi-api"
JWT_AUDIENCE="businesspaddi-web"
MAXMIND_ACCOUNT_ID="your-account-id"
MAXMIND_LICENSE_KEY="your-license-key"
MAXMIND_DB_PATH="data/GeoLite2-City.mmdb"
# Required before saving or reading encrypted banking/TIN/pension identifiers.
# Generate once, retain securely, and use the same value across deployments.
# PAYROLL_ENCRYPTION_KEY="<base64-encoded-32-random-bytes>"
# Task evidence: Cloudinary authenticated images (never public product image URLs).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public HTTPS origin for cookie-authenticated task image read URLs in production.
TASK_PUBLIC_API_URL=http://localhost:5000

# Remita payroll POC: disabled by default; no live mode exists.
PAYROLL_PROVIDER=disabled
REMITA_MODE=mock
PAYROLL_PLATFORM_FEE_KOBO=10000
REMITA_RECONCILER_ENABLED=true
# Mock mode must leave these credentials/URL empty.
REMITA_MERCHANT_ID=
REMITA_SERVICE_TYPE_ID=
REMITA_API_KEY=
REMITA_BASE_URL=
# Sandbox only: set credential provenance and approved provider fixture accounts.
# REMITA_CREDENTIAL_ENV=sandbox
# REMITA_BASE_URL=https://demo.remita.net/remita/exapp/api/v1/send/api/echannelsvc
REMITA_SANDBOX_SPLIT_APPROVED=false
# PAYROLL_PLATFORM_BANK_CODE=<approved sandbox bank code>
# PAYROLL_PLATFORM_ACCOUNT_NUMBER=<approved fake account>
# PAYROLL_PLATFORM_BENEFICIARY_NAME=<approved vendor name>
# REMITA_SANDBOX_FIXTURE_ACCOUNTS=<bankCode:fakeAccount,bankCode:fakeAccount>
