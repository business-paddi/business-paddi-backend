model User {
  inventoryCarts InventoryCart[]
  inventoryQuotes InventoryQuote[]
  id                          String           @id @default(cuid())
  email                       String           @unique
  name                        String           @db.VarChar(40)
  avatar                      String?
  bio                         String?
  username                    String?          @unique
  emailVerifiedAt             DateTime?        @db.Timestamptz(3)
  status                      Status           @default(active)
  passwordHash                String?
  preferences                 UserPreference?
  createdAt                   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime         @updatedAt @db.Timestamptz(3)
  sessions                    UserSession[]
  authProviders               AuthProvider[]
  onboardingDraft             OnboardingDraft?
  businessMemberships         BusinessMember[] @relation("MemberUser")
  invitedBusinessMembers      BusinessMember[] @relation("MemberInviter")
  businessMemberRoleChanges   BusinessMember[] @relation("MemberRoleUpdater")
  businessMemberStatusChanges BusinessMember[] @relation("MemberStatusUpdater")
  removedBusinessMembers      BusinessMember[] @relation("MemberRemover")
  businessInvites              BusinessInvite[]
  reviewedBusinessMembers      BusinessMember[] @relation("MemberApprovalReviewer")
  businessCreationRequests    BusinessCreationRequest[]
  notifications               UserNotification[]
}

model UserNotification {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteId  String?
  invite    BusinessInvite? @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  businessId String?
  business Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)
  title String? @db.VarChar(200)
  message String? @db.VarChar(1000)
  actionUrl String? @db.VarChar(500)
  data Json?
  eventKey String? @db.VarChar(200)
  type      String @default("business_invite")
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@unique([userId, eventKey])
  @@index([userId, readAt, createdAt])
  @@index([inviteId])
}

enum Status {
  active
  suspended
  pending_delete
  banned
}

model UserPreference {
  sidebarMinimized Boolean @default(false)
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  desktopNotifications Boolean @default(true)
  twoFactorEnabled     Boolean @default(false)

  onboardingUseCases        String[]  @default([])
  onboardingUsage           String?   @db.VarChar(20)
  onboardingReferralSource  String?   @db.VarChar(40)
  onboardingReferralDetails String?   @db.VarChar(200)
  onboardingCompletedAt     DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
